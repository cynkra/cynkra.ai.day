# Copy this file to .env.local and fill in real values for local dev.
# `lib/env.ts` validates these at process boot — missing or malformed
# values crash the app immediately rather than at first request.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# `development`, `test`, or `production`. Set automatically by Next.js;
# only override for unusual scenarios.
NODE_ENV=development

# Public URL the app is reachable on. Used by Auth.js for OAuth callback URLs.
# In dev, defaults to http://localhost:3000.
NEXTAUTH_URL=http://localhost:3000

# A long, random string used to sign sessions. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# -----------------------------------------------------------------------------
# Database (Postgres 16)
# -----------------------------------------------------------------------------

# Default credentials match docker-compose.yml. Change for prod.
DATABASE_URL=postgres://devnest:devnest@localhost:5432/devnest

# -----------------------------------------------------------------------------
# OAuth — GitHub
# Register an OAuth app at https://github.com/settings/developers
# Set callback URL to {NEXTAUTH_URL}/api/auth/callback/github
# -----------------------------------------------------------------------------

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OAuth — GitLab
# Register an OAuth app at https://gitlab.com/-/profile/applications
# Set redirect URI to {NEXTAUTH_URL}/api/auth/callback/gitlab
# Required scopes: read_user
# -----------------------------------------------------------------------------

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email magic-link
# In dev, point at Mailhog (started by `pnpm db:up`). In prod, use Resend or
# any SMTP provider.
# -----------------------------------------------------------------------------

EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=DevNest <noreply@devnest.local>
