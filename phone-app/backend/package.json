{
  "name": "@phone-app/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "migrate:up": "node-pg-migrate -d DATABASE_URL -m migrations -j ts up",
    "migrate:down": "node-pg-migrate -d DATABASE_URL -m migrations -j ts down",
    "migrate:create": "node-pg-migrate -m migrations -j ts create"
  },
  "dependencies": {
    "@phone-app/shared": "*",
    "@anthropic-ai/sdk": "^0.40.0",
    "@google-cloud/translate": "^8.5.0",
    "@simplewebauthn/server": "^11.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/cookie": "^11.0.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "node-pg-migrate": "^7.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0"
  }
}
