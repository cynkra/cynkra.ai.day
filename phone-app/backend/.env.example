# Copy this file to .env.local and fill in the required values.
# .env.local is gitignored.

# REQUIRED ─────────────────────────────────────────────────────────────────

# JWT signing key — must be at least 32 characters.
# Generate a fresh one with:  openssl rand -base64 48
JWT_SIGNING_KEY=replace-me-must-be-at-least-32-chars-long

# Postgres connection string. Create the database first:
#   createdb phone_app
# Then run migrations:
#   npm run --workspace @phone-app/backend migrate:up
DATABASE_URL=postgres://localhost:5432/phone_app

# OPTIONAL ─────────────────────────────────────────────────────────────────

# NODE_ENV=development
# PORT=3000
# HOST=0.0.0.0

# JWT_PREVIOUS_SIGNING_KEY=          # set during a key rotation
# JWT_ISSUER=phone-app
# JWT_AUDIENCE=phone-app
# JWT_TTL_SECONDS=2592000             # 30 days

# LLM (real Anthropic, used by section 4 of build-anki-iphone-app)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# External translator (used by enrichment_mode = external)
# GOOGLE_TRANSLATE_API_KEY=
# GOOGLE_TRANSLATE_PROJECT_ID=

# OAuth providers (currently stubbed)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# APPLE_TEAM_ID=
# APPLE_SERVICE_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# WebAuthn (currently stubbed)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Phone App
# WEBAUTHN_ORIGIN=http://localhost:3000

# Magic link
# MAGIC_LINK_TTL_SECONDS=900
# MAGIC_LINK_BASE_URL=http://localhost:3000/auth/verify

# Per-user daily budgets
# DAILY_LLM_BUDGET=200
# DAILY_EXTERNAL_BUDGET=1000
